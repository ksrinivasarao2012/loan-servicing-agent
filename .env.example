# Copy this file to .env and fill in your own keys. Never commit .env.

# Which LLM provider the agent uses: gemini or groq
LLM_PROVIDER=gemini

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your-gemini-key-here
# Stable Flash-Lite model; change if your free tier lists a different one.
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=your-groq-key-here
# Production model on Groq; see https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
